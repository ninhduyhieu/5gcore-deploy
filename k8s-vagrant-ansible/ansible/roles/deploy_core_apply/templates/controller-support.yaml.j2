apiVersion: v1
kind: ServiceAccount
metadata:
  name: ctrl-acc
  namespace: {{ etri_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ctrl-config
  namespace: {{ etri_namespace }}
data:
  controller.json: |
    {
      "server": {
        "port": 8888
      }
    }
---
apiVersion: v1
kind: Service
metadata:
  name: ctrl-svc
  namespace: {{ etri_namespace }}
spec:
  selector:
    app: controller
  ports:
    - port: 8888
      targetPort: 8888
      protocol: TCP
  type: ClusterIP