apiVersion: apps/v1
kind: Deployment
metadata:
  name: gw-dep
  namespace: {{ etri_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: gateway
  template:
    metadata:
      labels:
        app: gateway
    spec:
      nodeSelector:
        {{ worker2_role_label_key }}: "true"
      containers:
        - name: gateway
          image: b5gc-gateway:latest
          imagePullPolicy: Never
          ports:
            - containerPort: 7777
---
apiVersion: v1
kind: Service
metadata:
  name: gw-svc
  namespace: {{ etri_namespace }}
spec:
  selector:
    app: gateway
  ports:
    - port: 7777
      targetPort: 7777
      protocol: TCP
  type: ClusterIP